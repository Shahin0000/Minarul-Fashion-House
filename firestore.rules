rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin authorization check:
    // Strictly determined from Firestore users/{uid}.role == 'admin'
    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ----------------- USERS COLLECTION -----------------
    match /users/{userId} {
      // Customer can read their own profile; Admin can read any profile or list users
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // Creation: customer can create their own profile with role == 'customer'
      // Customer cannot self-assign role == 'admin'
      allow create: if isSignedIn() && (
        (isOwner(userId) && (
          !('role' in request.resource.data) || 
          request.resource.data.role == 'customer'
        )) ||
        isAdmin()
      );

      // Update: user can update own profile, but CANNOT escalate role to 'admin'
      allow update: if isSignedIn() && (
        (isOwner(userId) && (
          !('role' in request.resource.data) || 
          request.resource.data.role == resource.data.role
        )) ||
        isAdmin()
      );

      // Only Admin can delete users
      allow delete: if isAdmin();
    }

    // ----------------- PRODUCTS COLLECTION -----------------
    // Public can view/search products; Only Admin can add, edit, or delete
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ----------------- ORDERS COLLECTION -----------------
    // Customer can create order and read their own orders; Admin can read and manage all
    match /orders/{orderId} {
      allow read: if isAdmin()
                  || (
                    isSignedIn()
                    && resource.data.customerId == request.auth.uid
                  );

      allow create: if isSignedIn()
                    && request.resource.data.customerId == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    // ----------------- COUPONS COLLECTION -----------------
    // Public can read to validate coupons at checkout; Only Admin can manage
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ----------------- REVIEWS COLLECTION -----------------
    // Public can read published reviews; Admin can read all; Customer can read their own
    match /reviews/{reviewId} {
      allow read: if resource == null 
                  || resource.data.status == "published" 
                  || !('status' in resource.data) 
                  || isAdmin() 
                  || (isSignedIn() && resource.data.customerId == request.auth.uid);

      // Customer can create review if signed in and customerId matches UID
      allow create: if isSignedIn() && (
        isAdmin() || (
          request.resource.data.customerId == request.auth.uid &&
          request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
          (request.resource.data.status == 'published' || request.resource.data.status == 'pending')
        )
      );

      // Customer can update their own review (e.g. comment/rating/photos) or Admin can moderate
      allow update: if isSignedIn() && (
        isAdmin() || (
          isOwner(resource.data.customerId) &&
          request.resource.data.customerId == resource.data.customerId &&
          request.resource.data.status == resource.data.status
        )
      );

      // Only Admin or review author can delete
      allow delete: if isAdmin() || (isSignedIn() && isOwner(resource.data.customerId));
    }

    // ----------------- REVIEW REPORTS COLLECTION -----------------
    // Customers can submit reports on inappropriate reviews; Admin can view/manage
    match /reviewReports/{reportId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // ----------------- SETTINGS COLLECTION -----------------
    // Public can read site settings; Only Admin can modify settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ----------------- HERO SLIDES COLLECTION -----------------
    // Public can read slides; Only Admin can modify
    match /heroSlides/{slideId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ----------------- PHONE LOOKUP COLLECTION -----------------
    // Maps normalized phone number to registered user email for Mobile Login
    match /phoneLookup/{phone} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }
  }
}
